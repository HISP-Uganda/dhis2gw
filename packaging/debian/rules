#!/usr/bin/make -f

export DH_VERBOSE = 1
export CGO_ENABLED = 0

# dh_installsystemd is part of the normal compat 13 sequence. Let debhelper
# choose Ubuntu's merged-/usr systemd unit directory instead of hard-coding
# /lib/systemd or /usr/lib/systemd paths in the package.
%:
	dh $@

override_dh_auto_build:
	for binary in build/dhis2gw build/dhis2gw-worker build/dhis2gw-pbs-sync build/dhis2gw-migrate; do \
		test -x "$$binary" || { echo "missing executable: $$binary" >&2; exit 1; }; \
	done

override_dh_auto_clean:
	:

override_dh_installsystemd:
	dh_installsystemd --no-start --no-enable
